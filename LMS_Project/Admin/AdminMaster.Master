<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="AdminMaster.master.cs"
    Inherits="LearningManagementSystem.Admin.AdminMaster" %>

<!DOCTYPE html>
<html>
<head runat="server">
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>LMS Admin Panel</title>

<asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>

<link href="<%= ResolveUrl("~/assets/css/bootstrap.min.css") %>" rel="stylesheet" />
<link href="<%= ResolveUrl("~/assets/icons/fontawesome/css/all.min.css") %>" rel="stylesheet" />


<style>

/* ================= BASE ================= */
body {
    margin: 0;
    background: #f0f4f8;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto;
}

/* ================= LAYOUT ================= */
#main-wrapper {
    display: flex;
    min-height: 100vh;
}

/* ================= SIDEBAR ================= */
.sidebar {
    width: 240px;
    background: #f0f4fa;
    border-right: 3px solid #1565c0;
    position: fixed;
    height: 100vh;
    overflow-y: auto;
    transition: .3s;
    z-index: 1200;
    transition: all 0.3s ease;
}

#main-wrapper.sidebar-collapsed .sidebar {
    width: 20px;
}

/* LOGO */
.sidebar-header {
    padding: 15px;
    text-align: center;
    border-bottom: 1px solid #e3e8f0;
    position: sticky;
    top: 0;
    background: #f0f4fa;
    z-index: 2;
}

.sidebar-logo {
    max-height: 55px;
}

/* MENU */
.sidebar-menu {
    list-style: none;
    padding: 0;
}

.sidebar-section-label {
    font-size: 10px;
    font-weight: 700;
    color: #90a4ae;
    padding: 14px 18px 4px;
    text-transform: uppercase;
}

/* LINKS */
.sidebar-menu li a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 18px;
    text-decoration: none;
    color: #333;
    font-size: 14px;
    transition: .2s;
}

.sidebar-icon {
    width: 18px;
    color: #1976d2;
}

.sidebar-menu li a:hover {
    background: #e3f2fd;
    color: #1565c0;
}

/* ACTIVE */
.sidebar-link.active {
    background: #1565c0;
    color: #fff !important;
    position: relative;
}

.sidebar-link.active .sidebar-icon {
    color: #fff;
}

.sidebar-link.active::before {
    content: "";
    position: absolute;
    left: 0;
    width: 4px;
    height: 100%;
    background: #90caf9;
}

/* SUBMENU */
.sidebar-submenu {
    display: none;
    padding-left: 35px;
    border-left: 2px solid #e0e0e0;
}

.submenu.open .sidebar-submenu {
    display: block;
}

.right-icon {
    margin-left: auto;
    font-size: 11px;
    transition: .3s;
}

.submenu.open .right-icon {
    transform: rotate(90deg);
}

.header {
    min-height: 65px;
    background: linear-gradient(135deg, #1565c0, #1976d2);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 20px;
    position: fixed;
    left: 240px;
    right: 0;
    top: 0;
    z-index: 1100;
    flex-wrap: wrap;
    gap: 8px;
}

/* LEFT SECTION */
.header-left {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
    min-width: 180px;
}

/* CENTER (SESSION) */
.header-center {
    flex: 0 0 auto;
}

/* RIGHT ICONS */
.header-right {
    display: flex;
    align-items: center;
    gap: 12px;
}


#main-wrapper.sidebar-collapsed .header {
    left: 20px;
}

.header-title {
    color: #fff;
    font-size: 18px;
    font-weight: 700;
}
/* Header icon wrapper — needed for dot positioning */
.header-icon-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

/* Red alert dot */
.alert-dot {
    display: none;              /* hidden by default; JS shows it */
    position: absolute;
    top: -5px;
    right: -6px;
    width: 10px;
    height: 10px;
    background: #ef4444;
    border-radius: 50%;
    border: 2px solid #1565c0; /* matches header background */
    animation: dotPulse 1.8s ease-in-out infinite;
    z-index: 10;
}

@keyframes dotPulse {
    0%, 100% { transform: scale(1);    opacity: 1; }
    50%       { transform: scale(1.3); opacity: 0.7; }
}

.admin-badge {
    background: rgba(255,255,255,0.2);
    color: #fff;
    padding: 3px 10px;
    border-radius: 12px;
    font-size: 11px;
    margin-left: 10px;
}

/* PROFILE */
.profile-img {
    width: 35px;
    height: 35px;
    border-radius: 50%;
    border: 2px solid #90caf9;
}

/* ================= CONTENT ================= */
.content-wrapper {
    flex: 1;
    margin-left: 240px;
    margin-top: 65px;
    transition: .3s;
    transition: all 0.3s ease;
}

.content-wrapper {
    margin-left: 240px;
    margin-top: 70px; /* increase */
}

#main-wrapper.sidebar-collapsed .content-wrapper {
    margin-left: 50px;
}

.content-body {
    padding: 25px;
}

/* ================= RESPONSIVE ================= */
@media(max-width:992px){
    .sidebar {
        left: -260px;
    }

    #main-wrapper.sidebar-collapsed .sidebar {
        left: 0;
    }

    .header {
        left: 0 !important;
    }

    .content-wrapper {
        margin-left: 0 !important;
    }
}

/* ================= OVERLAY ================= */
.sidebar-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.4);
    z-index: 1150;
    display: none;
}

/* Show overlay */
#main-wrapper.sidebar-open .sidebar-overlay {
    display: block;
}

/* ================= RESPONSIVE ================= */
@media (max-width: 992px) {

    .sidebar {
        left: -260px;
    }

    #main-wrapper.sidebar-open .sidebar {
        left: 0;
    }

/*     prevent layout shift */
    .content-wrapper {
        margin-left: 0 !important;
    }

    .header {
        left: 0 !important;
    }
}

@media (max-width: 768px) {

    .header {
        flex-direction: column;
        align-items: stretch;
        height: auto;
        padding: 10px;
    }

    .header-left,
    .header-center,
    .header-right {
        width: 100%;
        justify-content: space-between;
    }

    .header-title {
        font-size: 14px;
    }

    .admin-badge {
        display: none;
    }

    #ddlGlobalSession {
        width: 100% !important;
        margin-top: 5px;
    }

    .content-wrapper {
        margin-top: 110px; /* 🔥 fix overlap */
    }
}

/* ===== HEADER FLEX FIX ===== */
.header {
    flex-wrap: wrap; /* allow wrapping */
    gap: 10px;
}

/* LEFT SECTION */
.header > div:first-child {
    flex: 1 1 auto;
    min-width: 200px;
}

/* SESSION FILTER */
.header > div:nth-child(2) {
    flex: 0 0 auto;
}

/* RIGHT ICONS */
.header ul.nav {
    flex: 0 0 auto;
}

/* MOBILE STACK */
@media (max-width: 768px) {

    .header {
        height: auto;
        padding: 10px;
        align-items: flex-start;
    }

    .header-title {
        font-size: 14px;
    }

    .admin-badge {
        display: none; /* prevent overflow */
    }

    /* STACK ELEMENTS */
    .header > div,
    .header ul.nav {
        width: 100%;
        justify-content: space-between;
    }

    /* SESSION DROPDOWN FULL WIDTH */
    #ddlGlobalSession {
        width: 100% !important;
    }

    .header ul.nav {
        justify-content: flex-end;
    }
}


</style>
</head>

<body>

<form runat="server">
<asp:ScriptManager runat="server" />

<div id="main-wrapper">
    <div class="sidebar-overlay"></div>

<!-- SIDEBAR -->
<div class="sidebar">

    <div class="sidebar-header">
        <asp:Image ID="imgInstituteLogo" runat="server" CssClass="sidebar-logo" />
    </div>

    <ul class="sidebar-menu">

        <li class="sidebar-section-label">Main</li>

        <li class="submenu">
         
            <a href="#" class="sidebar-link submenu-parent">
                <i class="fas fa-layer-group sidebar-icon"></i>
                <span>Dashboards</span>
                <i class="fas fa-chevron-right right-icon"></i>
            </a>
            <ul class="sidebar-submenu">                
                <li><a runat="server" href="~/Admin/Dashboards/OverviewDashboard.aspx" class="sidebar-link">OverviewDashboard</a></li>
                <li><a runat="server" href="~/Admin/Dashboards/MonthlyAnalyticsDashboard.aspx" class="sidebar-link">Monthly Analytics Dashboard</a></li>
                <li><a runat="server" href="~/Admin/Dashboards/Streamwisedashboard.aspx" class="sidebar-link">Streamwise Dashboard</a></li>
                <li><a runat="server" href="~/Admin/Dashboards/CourseWiseDashboard.aspx" class="sidebar-link">Coursewise Dashboard</a></li>
                <li><a runat="server" href="~/Admin/Dashboards/Studentmanagementdashboard.aspx" class="sidebar-link">Student Management</a></li>
                <li><a runat="server" href="~/Admin/Dashboards/TeacherManagementDashboard.aspx" class="sidebar-link">Teacher Management</a></li>
                <li><a runat="server" href="~/Admin/Dashboards/AttendanceAnalyticsDashboard.aspx" class="sidebar-link">Attendance Analytics</a></li>
                <li><a runat="server" href="~/Admin/Dashboards/AcademicAnalysisDashboard.aspx" class="sidebar-link">Academic Analysis</a></li>
                <li><a runat="server" href="~/Admin/Dashboards/AIInsightsDashboard.aspx" class="sidebar-link">AI Insights</a></li>
                <li><a runat="server" href="~/Admin/Dashboards/EventsCalendarDashboard.aspx" class="sidebar-link">Events & Calendar</a></li>
                <li><a runat="server" href="~/Admin/Dashboards/SystemUsageDashboard.aspx" class="sidebar-link">System Usage</a></li>                
                <li><a runat="server" href="~/Admin/Dashboards/CommunicationSupportDashboard.aspx" class="sidebar-link">Communication & Support</a></li>                

                     
                
                
            </ul>
        </li>

        <li class="sidebar-section-label">Management</li>

        <li class="submenu">
            <a href="#" class="sidebar-link submenu-parent">
                <i class="fas fa-layer-group sidebar-icon"></i>
                <span>Masters</span>
                <i class="fas fa-chevron-right right-icon"></i>
            </a>
            <ul class="sidebar-submenu">
                <li><a runat="server" href="~/Admin/AddStream.aspx" class="sidebar-link">Stream</a></li>
                <li><a runat="server" href="~/Admin/AddCourse.aspx" class="sidebar-link">Course</a></li>
                <li><a runat="server" href="~/Admin/AcademicSetup.aspx" class="sidebar-link">Academic Setup</a></li>
                <li><a runat="server" href="~/Admin/AcademicSession.aspx" class="sidebar-link">Academic Year</a></li>
                <li><a runat="server" href="~/Admin/AddSubject.aspx" class="sidebar-link">Subjects</a></li>
                <li><a runat="server" href="~/Admin/AddStudent.aspx" class="sidebar-link">Students</a></li>
                <li><a runat="server" href="~/Admin/AddTeacher.aspx" class="sidebar-link">Teachers</a></li>
                <li><a runat="server" href="~/Admin/ParentManagement.aspx" class="sidebar-link">Parents</a></li>
            </ul>
        </li>

        <li class="submenu">
            <a href="#" class="sidebar-link submenu-parent">
                <i class="fas fa-book-open sidebar-icon"></i>
                <span>Assign Course</span>
                <i class="fas fa-chevron-right right-icon"></i>
            </a>
            <ul class="sidebar-submenu">
                <li><a runat="server" href="~/Admin/AssignLevelSubject.aspx" class="sidebar-link">To Class</a></li>
                <li><a runat="server" href="~/Admin/AssignStudentSubject.aspx" class="sidebar-link">To Students</a></li>
                <li><a runat="server" href="~/Admin/AssignSubjectFaculty.aspx" class="sidebar-link">To Teachers</a></li>
            </ul>
        </li>

        <li class="sidebar-section-label">Reports</li>

        <li class="submenu">
            <a href="#" class="sidebar-link submenu-parent">
                <i class="fas fa-list sidebar-icon"></i>
                <span>Lists</span>
                <i class="fas fa-chevron-right right-icon"></i>
            </a>
            <ul class="sidebar-submenu">
                <li><a runat="server" href="~/Admin/StreamList.aspx">Streams</a></li>
                <li><a runat="server" href="~/Admin/CourseList.aspx">Courses</a></li>
                <li><a runat="server" href="~/Admin/Subjects.aspx">Upload Video/Materials</a></li>
                <li><a runat="server" href="~/Admin/StudentsList.aspx">Students</a></li>
                <li><a runat="server" href="~/Admin/TeacherList.aspx">Teachers</a></li>
                <li><a runat="server" href="~/Admin/ParentList.aspx">Parents</a></li>
            </ul>
        </li>

        <li class="sidebar-section-label">System</li>

        <li>
            <a runat="server" href="../Default.aspx" class="sidebar-link">
                <i class="fas fa-sign-out-alt sidebar-icon"></i>
                <span>Logout</span>
            </a>
        </li>

    </ul>
</div>

<!-- CONTENT -->
<div class="content-wrapper">



    <div class="header">

    <!-- LEFT -->
    <div class="header-left">
        <div class="collapse-sidebar" style="cursor:pointer;">
            <i class="fas fa-bars text-white"></i>
        </div>

        <div class="header-title text-truncate">
            <i class="fas fa-graduation-cap me-2"></i>
            <asp:Label ID="lblHeaderInstituteName" runat="server" />
        </div>

        <span class="admin-badge">Admin Portal</span>
    </div>

    <!-- CENTER -->
    <div class="header-center d-flex align-items-center">
        <asp:DropDownList ID="ddlGlobalSession" runat="server"
            CssClass="form-select form-select-sm"
            AutoPostBack="true"
            OnSelectedIndexChanged="ddlGlobalSession_SelectedIndexChanged"
            Style="width:150px;">
        </asp:DropDownList>

        <asp:Label ID="lblGlobalSession" runat="server"
        CssClass="admin-badge ms-2" />
    </div>

    <!-- RIGHT -->
    <!-- RIGHT -->
<div class="header-right">

    <a runat="server" href="~/Admin/AdminHelp.aspx" 
       class="header-icon-wrap" title="Help Requests">
        <i class="far fa-message text-white"></i>
        <span class="alert-dot" id="dotHelp"></span>
    </a>

    <a runat="server" href="~/Admin/AdminCalendar.aspx" 
       class="header-icon-wrap" title="Calendar Events">
        <i class="far fa-calendar-alt text-white"></i>
        <span class="alert-dot" id="dotCal"></span>
    </a>

    <a runat="server" href="~/Admin/Notifications.aspx" 
       class="header-icon-wrap" title="Notifications">
        <i class="far fa-bell text-white"></i>
        <span class="alert-dot" id="dotNotif"></span>
    </a>

    <div class="dropdown">
        <a href="#" data-bs-toggle="dropdown" aria-expanded="false"
           class="d-flex align-items-center" id="profileDropBtn">
            <asp:Image ID="imgProfilePhoto" runat="server" CssClass="profile-img me-2" />
            <i class="fas fa-chevron-down text-white"></i>
        </a>
        <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" href="~/Admin/AdminProfile.aspx" runat="server">Profile</a></li>
            <li><hr /></li>
            <li><a class="dropdown-item text-danger" href="../Default.aspx">Logout</a></li>
        </ul>
    </div>

</div>

</div>

<div class="content-body">
    <asp:ContentPlaceHolder ID="ContentPlaceHolder2" runat="server" />
</div>

</div>
</div>

<script src="<%= ResolveUrl("~/assets/js/bootstrap.bundle.min.js") %>"></script>

<script>
    (function () {

        /* ── Wait until Bootstrap is truly ready ── */
        function initAll() {

            /* 1. SIDEBAR TOGGLE */
            var wrapper = document.getElementById("main-wrapper");
            var toggleBtn = document.querySelector(".collapse-sidebar");
            var overlay = document.querySelector(".sidebar-overlay");

            if (toggleBtn) {
                toggleBtn.addEventListener("click", function () {
                    if (window.innerWidth <= 992)
                        wrapper.classList.toggle("sidebar-open");
                    else
                        wrapper.classList.toggle("sidebar-collapsed");
                });
            }
            if (overlay) {
                overlay.addEventListener("click", function () {
                    wrapper.classList.remove("sidebar-open");
                });
            }

            /* 2. SUBMENU */
            document.querySelectorAll(".submenu-parent").forEach(function (menu) {
                menu.addEventListener("click", function (e) {
                    e.preventDefault();
                    this.closest(".submenu").classList.toggle("open");
                });
            });

            /* 3. ACTIVE LINK */
            var current = window.location.pathname.split("/").pop().toLowerCase();
            document.querySelectorAll(".sidebar-link").forEach(function (link) {
                var href = (link.getAttribute("href") || "").toLowerCase();
                if (href && href !== "#" && href.split("/").pop() === current) {
                    link.classList.add("active");
                    var parent = link.closest(".submenu");
                    if (parent) parent.classList.add("open");
                }
            });

            /* 4. DROPDOWN — force init AFTER bootstrap is confirmed loaded */
            function initDropdowns() {
                if (typeof bootstrap !== "undefined" && bootstrap.Dropdown) {
                    document.querySelectorAll('[data-bs-toggle="dropdown"]').forEach(function (el) {
                        try {
                            // Dispose existing instance first to avoid double-bind
                            var existing = bootstrap.Dropdown.getInstance(el);
                            if (existing) existing.dispose();
                            new bootstrap.Dropdown(el);
                        } catch (e) { }
                    });
                } else {
                    /* Bootstrap not yet available — retry in 100ms */
                    setTimeout(initDropdowns, 100);
                }
            }
            initDropdowns();

            /* 5. ALERT DOTS */
            initAlertDots();
        }

        /* ── Alert dots ─────────────────────────────────────────────── */
        function initAlertDots() {

            /* Build an absolute path so it works from any subfolder depth:
               /Admin/GetHeaderAlerts.ashx  (always from root)             */
            var base = window.location.pathname;
            /* Find the /Admin/ segment and keep everything up to it */
            var adminIdx = base.toLowerCase().indexOf("/admin/");
            var handlerUrl = (adminIdx !== -1)
                ? base.substring(0, adminIdx) + "/Admin/GetHeaderAlerts.ashx"
                : "/Admin/GetHeaderAlerts.ashx";

            function setDot(id, show) {
                var el = document.getElementById(id);
                if (el) el.style.display = show ? "block" : "none";
            }

            function checkAlerts() {
                fetch(handlerUrl, { credentials: "same-origin" })
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (data) {
                        if (!data) return;
                        setDot("dotHelp", data.unreadHelp > 0);
                        setDot("dotCal", data.newEvents > 0);
                        setDot("dotNotif", data.unreadNotif > 0);
                    })
                    .catch(function () { /* silent — dots stay hidden */ });
            }

            checkAlerts();                        /* immediate check on load */
            setInterval(checkAlerts, 30000);      /* then every 30 s        */
        }

        /* Run after DOM is ready */
        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initAll);
        } else {
            initAll();   /* DOM already ready (happens on some postbacks) */
        }

    })();
</script>

</form>
</body>
</html>